# ---------------------------------------------------------------------------
# Compliance Rule Manager - server configuration
# Copy this file to ".env" in the same folder and fill in real values.
# Never commit the real ".env" file (it's already in .gitignore).
# ---------------------------------------------------------------------------

# Port the Express server listens on.
PORT=3000

# Base URL the app is reachable at (no trailing slash). Used to build the
# OAuth redirect URI and links back into the app.
#   Local testing:      http://localhost:3000
#   Internal server:    https://compliance.yourdistrict.k12.va.us
APP_BASE_URL=http://localhost:3000

# --- Google Cloud OAuth client (see README "Google Cloud setup" section) ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Restrict sign-in to your Workspace domain (also enforced server-side, not
# just via the Google "hd" hint, which can be spoofed on its own).
ALLOWED_DOMAIN=yourdistrict.example.org

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Set to "true" only once you have verified the live Cloud Identity Policy
# API DLP mutate call against your own tenant (see README "Gmail rule
# automation" section). When "false" (the safe default), Gmail rules are
# always created via the guided deep-link/manual flow instead of a live
# write call.
ENABLE_LIVE_DLP_API=false

# Google Workspace customer ID. Leave as "my_customer" unless Google support
# has told you to use a specific customer ID.
GOOGLE_CUSTOMER_ID=my_customer

# Set to "true" when running the server behind HTTPS (internal server /
# production). Keep "false" for local http://localhost testing.
COOKIE_SECURE=false
